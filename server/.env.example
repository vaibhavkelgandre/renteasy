# Copy to `.env` and fill in the blanks. `.env` is gitignored and must never be committed.

# ---- Server ----
# 5001, not 5000. Another project on this machine uses 5000, and sharing a port means
# the frontend silently proxies to the wrong backend - which surfaces as 404s from
# endpoints that exist perfectly well in the project you think you are running.
PORT=5001
NODE_ENV=development
APP_VERSION=0.1.0

# Where verification links point. This is the FRONTEND, which reads the token from the
# URL and POSTs it - the token never reaches an API endpoint as a query parameter.
APP_URL=http://localhost:5174

# The terms version a new account must accept. Registration refuses a stale one (409),
# so bump this in the same deploy as the terms themselves.
TERMS_VERSION=2026-09-01

# ---- Database (required) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=renteasy

# Alternative to the five above, and it WINS when set. Managed providers hand you one
# string and no parts. Leave commented out locally.
# DATABASE_URL=

# ---- Secrets (required) ----
# Generate a real one - never reuse an example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# There is deliberately NO default in code. A default like "dev-secret" is worse than a
# missing one: everything appears to work while the deployment signs real sessions with
# a value that is in the repository.
JWT_SECRET=

# ---- Mail (optional locally, required once deployed) ----
# Absent is a legitimate state: development logs the verification link to the console
# instead, which is why registration works on a laptop with none of this set.
# Production REFUSES to send rather than silently discarding - an unverifiable account
# is a broken signup.
#
# Fill both in to send for real, including locally (that is how you test against a real
# inbox). Both are checked together - a key with no sender reads as unconfigured,
# because Brevo rejects a send whose sender is not verified.
#
# From Brevo's "API Keys" tab. It MUST start with `xkeysib-`. The adjacent "SMTP" tab
# issues an `xsmtpsib-` credential for the SMTP relay, and the HTTP API rejects it with
# `Key not found` - a message that reads as a wrong key rather than the wrong KIND of
# key, and is the first thing to check on a 401.
#
# Use a SECOND key, not the one another project on this machine already uses: the
# quota is shared per account either way, but separate keys mean either app can be
# revoked without taking the other down.
BREVO_API_KEY=

# Must be an address Brevo has VERIFIED, or every send fails. The display name is
# free-form - Brevo verifies the address, so the same verified address can front
# several projects under different names.
#
# NO QUOTES. dotenv strips one surrounding pair from this file and a hosting dashboard
# stores them verbatim, so a quoted value works locally and arrives broken in
# production. (mailer.js absorbs both quoting mistakes anyway - do not rely on it.)
MAIL_FROM=RentEasy <you@example.com>
