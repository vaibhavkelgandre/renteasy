{
  "name": "renteasy-server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "seed": "node src/scripts/seedDemo.js",
    "migrate": "node src/scripts/runMigrations.js",
    "migrate:status": "node src/scripts/runMigrations.js --status",
    "migrate:test": "node -r dotenv/config src/scripts/runMigrations.js dotenv_config_path=.env.test"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.12.0",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "vitest": "^2.1.0"
  }
}
