# Copy to `.env.test` and fill in DB_PASSWORD. Loaded by tests/setup.js with override.
#
# The suite TRUNCATEs tables between tests, so pointing it at real data is silent,
# total loss - reported as a healthy green run. Three protections, and you want all
# three: this file, the blanked DATABASE_URL below, and testDatabaseGuard.js.
#
#   psql -U postgres -c "CREATE DATABASE renteasy_test;"
#   npm run migrate:test

NODE_ENV=test

# DB_NAME must end in `_test` or the guard refuses to run.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=renteasy_test

# BLANKED ON PURPOSE - do not delete this line and do not fill it in.
# DATABASE_URL takes precedence over the DB_* parts above, so one left in your shell
# from migrating a deployed database would win here and the suite would truncate THAT.
DATABASE_URL=

JWT_SECRET=test-secret-not-used-anywhere-real
TERMS_VERSION=2026-09-01

# BLANKED ON PURPOSE, same reasoning as DATABASE_URL above - and do not delete these
# two lines. env.js calls dotenv.config() on import, so a value present in `.env` and
# merely ABSENT here still lands in process.env during a test run. Blanking is what
# actually removes it.
#
# Belt and braces: mailer.js hard-returns into its in-memory outbox when NODE_ENV=test,
# ahead of every other branch, so the suite cannot reach the network even with both of
# these filled in. That guard is the half that protects a fresh clone, since this file
# is gitignored.
BREVO_API_KEY=
MAIL_FROM=

# BLANKED ON PURPOSE, same reasoning as the mail keys above. env.js calls
# dotenv.config() on import, so a value present in `.env` and merely ABSENT here still
# lands in process.env during a test run.
#
# Belt and braces: config/cloudinary.js returns a deterministic fake when
# NODE_ENV=test, ahead of every other branch, so the suite cannot reach the network or
# write assets into a real account even with these filled in.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
